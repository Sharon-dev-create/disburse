# Execution service base URL (server-only usage in app code paths)
DISBURSE_EXECUTION_API_BASE_URL=http://127.0.0.1:4000

# Local/demo-only server-side shared token sent as Authorization: Bearer <token>
# by the frontend server to the execution service. Never use NEXT_PUBLIC_*.
# Not production identity authentication.
# DISBURSE_EXECUTION_API_DEMO_TOKEN=replace-with-at-least-16-random-characters

# Optional marketing call-to-action URL:
# NEXT_PUBLIC_LAUNCH_URL=
