generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CampaignStatus {
  DRAFT
  APPROVED
  REJECTED
  COMPLETED
}
enum PayoutStatus {
  CREATED
  QUOTED
  RESERVED
  COMMITTED
  AWAITING_DEPOSIT
  PROCESSING
  SUCCESS
  FAILED
  EXPIRED
  REFUND_PENDING
  REFUNDED
  UNKNOWN
}
enum LedgerType {
  BUDGET_APPROVED
  RESERVED
  RELEASED
  DEPOSIT_OBSERVED
  DEPOSIT_REVERSED
  PROVIDER_SETTLEMENT_REPORTED
  PROVIDER_REFUND_REPORTED
  RECIPIENT_OUTPUT_VERIFIED
  SETTLEMENT_CONFIRMED
  REFUND_INITIATED
  REFUND_CONFIRMED
  FAILED
  ADJUSTMENT
}

enum EvmFundingState {
  CREATED
  AUTHORIZED
  SIGNED
  BROADCAST
  CONFIRMING
  CONFIRMED
  REJECTED
  FAILED
  UNKNOWN
  REORGED
}

enum RecipientOutputState {
  NOT_CHECKED
  PENDING
  VERIFIED
  MISMATCH
  MANUAL_REVIEW
}

enum PayoutWorkState {
  READY
  LEASED
  DONE
  MANUAL_REVIEW
}

model Campaign {
  id             String         @id
  idempotencyKey String         @unique
  budget         BigInt
  assetId        String
  sourceChain    String         @default("UNKNOWN")
  decimals       Int
  status         CampaignStatus @default(DRAFT)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  payouts        Payout[]
  ledger         LedgerEntry[]
  reservations   Reservation[]
  evmFundingOperations EvmFundingOperation[]
}

model Payout {
  id                String        @id
  campaignId        String
  recipientId       String
  idempotencyKey    String?       @unique
  recipientAddress  String
  promisedAmount    BigInt
  outputAssetId     String
  outputChain       String
  status            PayoutStatus  @default(CREATED)
  activeExposure    BigInt        @default(0)
  recipientOutputState RecipientOutputState @default(NOT_CHECKED)
  recipientOutputTxHash String?
  recipientOutputBlockHash String?
  recipientOutputVerifiedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  campaign          Campaign      @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  attempts          Attempt[]
  events            PayoutEvent[]
  ledger            LedgerEntry[]
  reservations      Reservation[]
  evmFundingOperations EvmFundingOperation[]
  workItems         PayoutWorkItem[]
  @@unique([campaignId, recipientId])
}

model Attempt {
  id              String       @id
  payoutId        String
  attemptNo       Int
  retryKey        String?      @unique
  quoteId         String?      @unique
  maxAmountIn     BigInt?
  inputAssetId    String?
  inputChain      String?
  outputAmount    BigInt?
  expiresAt       DateTime?
  timeWhenInactive DateTime?
  depositAddress  String?
  depositMemo     String?
  status          PayoutStatus @default(CREATED)
  providerJson    Json?
  providerStatus  String?
  providerStatusUpdatedAt DateTime?
  providerDepositedAmount BigInt?
  createdAt       DateTime     @default(now())
  payout          Payout       @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  reservation     Reservation?
  ledgerEntries   LedgerEntry[]
  evmFundingOperations EvmFundingOperation[]
  @@unique([payoutId, attemptNo])
}

model PayoutEvent {
  id          String       @id @default(cuid())
  payoutId    String
  fromStatus  PayoutStatus?
  toStatus    PayoutStatus
  note        String
  providerRef String?
  txHash      String?
  createdAt   DateTime     @default(now())
  payout      Payout       @relation(fields: [payoutId], references: [id], onDelete: Restrict)
}

model Reservation {
  id         String   @id
  campaignId String
  payoutId   String?
  attemptId  String?  @unique
  amount     BigInt
  remainingAmount BigInt @default(0)
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  releasedAt DateTime?
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  payout     Payout?  @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  attempt    Attempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  evmFundingOperation EvmFundingOperation?
}

model LedgerEntry {
  id          String    @id @default(cuid())
  campaignId  String
  payoutId    String?
  attemptId   String?
  type        LedgerType
  amount      BigInt
  direction   String    @default("IN")
  assetId     String
  externalRef String?   @unique
  reason      String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  payout      Payout?   @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  attempt     Attempt?  @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  @@index([campaignId, createdAt])
  @@index([campaignId, attemptId, type])
}

model EvmFundingOperation {
  id                   String          @id @default(cuid())
  campaignId           String
  payoutId             String
  attemptId            String
  reservationId        String          @unique
  idempotencyKey       String          @unique
  quoteId              String
  chainId              BigInt
  sourceAssetId        String
  sourceChain           String
  sourceAddress        String
  destinationMemo      String?
  tokenAddress         String
  tokenAmount          BigInt
  tokenDecimals        Int
  destinationAddress   String
  quoteExpiresAt       DateTime
  nonce                BigInt
  gasLimit             BigInt
  maxFeePerGas         BigInt
  maxPriorityFeePerGas BigInt
  maxGasLimit          BigInt
  maxFeePerGasCap      BigInt
  maxPriorityFeePerGasCap BigInt
  maxNativeGasCost     BigInt
  txHash               String?
  signedTxCiphertext   String?
  signedTxIv           String?
  signedTxAuthTag      String?
  state                EvmFundingState @default(CREATED)
  failureReason        String?
  lastObservedBlock    BigInt?
  lastObservedBlockHash String?
  createdAt            DateTime        @default(now())
  authorizedAt         DateTime?
  signedAt             DateTime?
  broadcastAt          DateTime?
  confirmedAt          DateTime?
  reconciledAt         DateTime?
  updatedAt            DateTime        @updatedAt
  campaign             Campaign        @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  payout               Payout          @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  attempt              Attempt         @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  reservation          Reservation    @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@unique([chainId, sourceAddress, nonce])
  @@index([campaignId, state, createdAt])
  @@index([payoutId, attemptId])
  @@index([txHash])
}

model PayoutWorkItem {
  id          String         @id @default(cuid())
  payoutId    String
  kind        String         @default("SINGLE_PAYOUT")
  payload     Json
  state       PayoutWorkState @default(READY)
  attempts    Int            @default(0)
  maxAttempts Int            @default(12)
  availableAt DateTime       @default(now())
  leaseUntil  DateTime?
  lockToken   String?
  lastError   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  payout      Payout         @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([payoutId, kind])
  @@index([state, availableAt])
  @@index([leaseUntil])
}

model EvmNonceCursor {
  id          String   @id @default(cuid())
  chainId     BigInt
  sourceAddress String
  nextNonce   BigInt
  updatedAt   DateTime @updatedAt

  @@unique([chainId, sourceAddress])
}
