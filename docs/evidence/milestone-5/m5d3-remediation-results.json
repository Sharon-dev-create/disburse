  "implementation": {
    "source_file": "execution-service/src/persistence/postgres-job-repository.ts",
    "test_file": "execution-service/tests/integration/postgres-jobs.test.ts",
    "public_interfaces_unchanged": true,
    "schema_and_migrations_unchanged": true,
    "helper_changes": [
      "hasValidLease locks matching lease before separate current-time query, retaining owner/generation/job-version checks",
      "updateJobState optionally enforces lease owner, job/lease fencing and current deadline within conditional SQL",
      "releaseLease requires exact-one deletion before version bump",
      "shared renewal, deletion and post-attempt/failure guards use clock_timestamp; renewal extension uses current DB time"
    ],
    "sql_lock_order": "job row -> matching lease row -> conditional mutation, locks retained through commit",
    "clock_semantics": "clock_timestamp for ownership/deadlines; statement_timestamp retained for ordinary audit metadata",
    "rollback": "Any stale guard, zero-row required mutation or later error rolls back provisional job/lease/attempt changes",
    "release_semantics": "Owner release requires a live lease; existing recoverExpiredLeases and claimNext support legitimate expired cleanup/reclamation. Duplicate owner release rejects with no extra version change. A successful deletion authorizes its atomic following version update; commit acknowledgement can be later.",
    "final_fence_invariants": "job source state/version/fencing counter and matching lease worker/fence/deadline checked; absent lease rejected for protected states"
  },
