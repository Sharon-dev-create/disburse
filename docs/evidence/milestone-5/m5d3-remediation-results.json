      "id": "M5D2-01",
      "severity": "MEDIUM",
      "root_cause": "Final nonterminal UPDATE lacked current owner/fence/expiry predicates after initial validation and later lock waits",
      "fix": "Lock job then matching lease; separate fresh clock validation; conditional state/version/fence/lease UPDATE with affected-row check",
      "status": "FIXED_LOCAL_REGRESSION_VERIFIED"
    },
    {
      "id": "M5D2-02",
      "severity": "MEDIUM",
      "root_cause": "Conditional lease DELETE row count ignored before unconditional version bump",
      "fix": "Reuse exact-one guarded deletion; only then bump version atomically; failure rolls back all changes",
      "status": "FIXED_LOCAL_REGRESSION_VERIFIED"
    }
  ],
