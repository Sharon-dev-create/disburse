[
  {
    "name": "fmt",
    "command": [
      "cargo",
      "fmt",
      "--all",
      "--",
      "--check"
    ],
    "exit_code": 0,
    "log": "fmt.log"
  },
  {
    "name": "clippy",
    "command": [
      "cargo",
      "clippy",
      "--locked",
      "--all-targets",
      "--",
      "-D",
      "warnings"
    ],
    "exit_code": 0,
    "log": "clippy.log"
  },
  {
    "name": "unit-tests",
    "command": [
      "cargo",
      "test",
      "--locked"
    ],
    "exit_code": 0,
    "log": "unit-tests.log"
  },
  {
    "name": "build",
    "command": [
      "cargo",
      "near",
      "build",
      "non-reproducible-wasm",
      "--locked"
    ],
    "exit_code": 0,
    "log": "build.log"
  },
  {
    "name": "fixture-fmt",
    "command": [
      "cargo",
      "fmt",
      "--manifest-path",
      "tests/sandbox/token/Cargo.toml",
      "--",
      "--check"
    ],
    "exit_code": 0,
    "log": "fixture-fmt.log"
  },
  {
    "name": "diff-check",
    "command": [
      "git",
      "diff",
      "--check"
    ],
    "exit_code": 0,
    "log": "diff-check.log"
  }
]
