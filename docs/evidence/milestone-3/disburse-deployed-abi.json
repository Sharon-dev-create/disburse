    "root_schema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "String",
      "type": "string",
      "definitions": {
        "Campaign": {
          "description": "Campaign accounting invariant for funded campaigns: reserved + spent <= funded <= budget. Approved budget is an authorization ceiling, not evidence of funds received.",
          "type": "object",
          "required": [
            "budget",
            "created_at_ns",
            "creator_id",
            "funded",
            "id",
            "reserved",
            "spent",
            "status",
            "title",
            "token_id"
          ],
          "properties": {
            "budget": {
              "type": "integer",
              "format": "uint128",
              "minimum": 0.0
            },
            "created_at_ns": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
