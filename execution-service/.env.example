# Disburse execution-service local host (read-only HTTP API, demo milestone)
# Copy to an untracked local file (for example .env.local) and set real values.
# Never commit secrets, tokens, passwords, or private keys.

# HTTP server
DISBURSE_API_HOST=127.0.0.1
DISBURSE_API_PORT=4000

# Local/demo-only server-side shared token for Authorization: Bearer <token>.
# Required for protected API routes. Never use NEXT_PUBLIC_* and never log this value.
# Not production identity authentication.
DISBURSE_EXECUTION_API_DEMO_TOKEN=replace-with-at-least-16-random-characters

# PostgreSQL (host runs migrations on startup and serves persisted job reads)
# DISBURSE_POSTGRES_TARGET selects which database URL/config is used: development | test | production
DISBURSE_POSTGRES_TARGET=development
# Keep actual URLs in an untracked mode-600 file. Passwords are never logged.
DISBURSE_DEV_DATABASE_URL=postgresql://disburse_dev:replace-me@127.0.0.1:5432/disburse_dev
DISBURSE_TEST_DATABASE_URL=postgresql://disburse_test:replace-me@127.0.0.1:5432/disburse_test
# DISBURSE_DATABASE_URL=postgresql://user:replace-me@host:5432/disburse

# NEAR read-only contract access (existing views only; no signing/mutation)
NEAR_NETWORK=testnet
NEAR_RPC_ENDPOINT=https://rpc.testnet.near.org
DISBURSE_CONTRACT_ID=replace-with-authorized-contract.testnet
# DISBURSE_NEAR_RPC_TIMEOUT_MS=10000

# Optional discovery/provider placeholders (not required by the read-only HTTP host)
# NEAR_DISCOVERY_START_BLOCK=replace-with-deployment-block
# NEAR_DATA_ENDPOINT=https://testnet.neardata.xyz
# FASTNEAR_API_KEY=replace-with-provider-key
# NEAR_INTENTS_API_KEY=replace-with-partner-api-key
