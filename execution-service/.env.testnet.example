# Milestone 11 testnet preflight placeholders only. This file cannot sign or submit transactions.
# Use NEAR's local keystore; never place seed phrases or private keys in environment files.
NEAR_NETWORK=testnet
NEAR_RPC_ENDPOINT=https://rpc.testnet.near.org
NEAR_DATA_ENDPOINT=https://testnet.neardata.xyz
NEAR_DEPLOYMENT_ACCOUNT=replace-with-disposable.testnet
DISBURSE_CONTRACT_ID=replace-with-authorized-contract.testnet
NEAR_INITIALIZER_ACCOUNT=replace-with-owner.testnet
NEAR_EXPECTED_OWNER_ACCOUNT=replace-with-owner.testnet
NEAR_OPERATOR_ACCOUNT=replace-with-distinct-operator.testnet
NEAR_VERIFIER_ACCOUNT=replace-with-distinct-verifier.testnet
TEST_TOKEN_CONTRACT=replace-with-verified-token.testnet
TEST_TOKEN_FUNDER_ACCOUNT=replace-with-funded-account.testnet
# Token metadata and campaign parameters must be set only after live metadata verification.
TEST_TOKEN_EXPECTED_SYMBOL=replace-after-verification
TEST_TOKEN_EXPECTED_DECIMALS=replace-after-verification
TEST_CAMPAIGN_BUDGET_ATOMIC=1
TEST_PAYOUT_INPUT_ATOMIC=1
